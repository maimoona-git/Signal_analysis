---
// Status Readout motif (DESIGN.md #4): a monospace data tag with a status
// dot, for actual technical values -- a modulation scheme, an FEC code, a
// build/test result -- never a decorative label on ordinary prose.
interface Props {
  variant?: "active" | "attention" | "neutral";
  class?: string;
}
const { variant = "neutral", class: className } = Astro.props;
---

<span class:list={["badge", `badge--${variant}`, className]}>
  <span class="badge__dot" aria-hidden="true"></span><slot />
</span>

<style>
  .badge {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    padding: var(--space-1) var(--space-3);
    border: var(--panel-border-width) solid var(--line);
    border-radius: var(--panel-radius);
    background: var(--surface-raised);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .badge__dot {
    width: 0.5em;
    height: 0.5em;
    border-radius: 50%;
    background: var(--muted);
    flex: none;
  }

  .badge--active .badge__dot {
    background: var(--phosphor);
  }

  .badge--attention .badge__dot {
    background: var(--amber);
  }
</style>

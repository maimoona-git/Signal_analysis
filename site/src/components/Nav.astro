---
// Persistent instrument bezel: always the dark scheme, regardless of the page
// content underneath it (BaseLayout wraps this in its own data-scheme="dark"
// block). Only one page exists besides the app itself, so the wordmark alone
// is the way home -- no separate nav-links list to keep in sync.
---

<header class="nav">
  <div class="nav__inner">
    <a href="/" class="nav__wordmark">PS 26147</a>
    <nav class="nav__links" aria-label="Primary">
      <a href="/web/" class="nav__launch">Launch app</a>
    </nav>
  </div>
</header>

<style>
  .nav {
    background: var(--surface);
    color: var(--text);
    border-bottom: var(--panel-border-width) solid var(--line);
  }

  .nav__inner {
    max-width: var(--content-max-width);
    margin: 0 auto;
    padding: var(--space-4) var(--space-5);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-5);
  }

  .nav__wordmark {
    font-family: var(--font-mono);
    font-weight: 600;
    font-size: var(--text-lg);
    letter-spacing: 0.02em;
    text-decoration: none;
    color: var(--text);
  }

  .nav__links {
    display: flex;
    align-items: center;
    gap: var(--space-5);
    font-family: var(--font-mono);
    font-size: var(--text-sm);
  }

  .nav__launch {
    padding: var(--space-2) var(--space-4);
    border: var(--panel-border-width) solid var(--phosphor-dim);
    border-radius: var(--panel-radius);
    color: var(--phosphor);
    text-decoration: none;
  }

  .nav__launch:hover {
    background: var(--phosphor-dim);
    color: var(--ink-950);
  }

  @media (max-width: 32rem) {
    .nav__inner {
      flex-direction: column;
      align-items: flex-start;
    }
    .nav__links {
      flex-wrap: wrap;
    }
  }
</style>

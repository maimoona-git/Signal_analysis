---
// Instrument Panel motif (DESIGN.md #1): a bordered box with a nameplate tab
// overlapping the top border, the way a piece of rack equipment labels its
// own module. `label` names what the panel IS, not a decorative eyebrow above
// unrelated content -- use it for e.g. "PIPELINE STAGE 3" or "FEC OPTIONS",
// never as a generic "OVERVIEW" tacked above prose.
interface Props {
  label: string;
  class?: string;
}
const { label, class: className } = Astro.props;
---

<div class:list={["panel", className]}>
  <span class="panel__label">{label}</span>
  <div class="panel__body">
    <slot />
  </div>
</div>

<style>
  .panel {
    position: relative;
    margin-top: 0.9em;
    border: var(--panel-border-width) solid var(--line);
    border-radius: var(--panel-radius);
    background: var(--surface-raised);
  }

  .panel__label {
    position: absolute;
    top: -0.7em;
    left: var(--space-4);
    padding: 0 var(--space-2);
    background: var(--surface);
    color: var(--muted);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .panel__body {
    padding: var(--space-6) var(--space-5) var(--space-5);
  }
</style>

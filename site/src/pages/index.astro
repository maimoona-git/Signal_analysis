---
import LandingLayout from "../layouts/LandingLayout.astro";

const stages = [
  { title: "Ingestion", detail: "A .wav or .IQ file is read as bytes. Nothing leaves the browser." },
  { title: "DSP and spectral analysis", detail: "FFT and spectrogram, computed in WebAssembly." },
  { title: "ML classification", detail: "A small ONNX model guesses the modulation scheme, in JavaScript." },
  { title: "Demodulation", detail: "17 linear schemes plus FSK, back in the WASM core." },
  { title: "De-interleaving", detail: "Block, diagonal, convolutional or pseudo-random, undone." },
  { title: "FEC decoding", detail: "Viterbi, LDPC, Reed-Solomon, or both concatenated." },
  { title: "Bitstream correlation", detail: "Repeating headers and frame boundaries, found in the decoded bits." },
  { title: "GUI", detail: "Qt Widgets, compiled to WASM, showing every stage above." },
];

const features = [
  {
    title: "Frame raster",
    text: "Lays the decoded bits out at a row width you choose, so repeating frame structure shows up as vertical stripes.",
  },
  {
    title: "Rank analysis",
    text: "Finds a block code's length and rate from raw bits alone, by looking for rank drops over GF(2).",
  },
  {
    title: "Parameter search",
    text: "Tries every offset, interleaver and FEC combination and ranks them by how well the decode re-encodes to the input.",
  },
  {
    title: "Waterfall and constellation",
    text: "Both plots zoom with the wheel and pan by dragging, so a short burst can be inspected up close.",
  },
];
---

<LandingLayout
  title="Deconflicted: signal analysis in your browser"
  description="Deconflicted is a signal analysis tool that runs entirely in your browser, with no server."
>
  <section class="hero">
    <canvas class="hero__waves" id="waves" aria-hidden="true"></canvas>
    <div class="disc" aria-hidden="true">
      <canvas id="globe"></canvas>
    </div>
    <p class="wordmark" aria-hidden="true"><b>de</b><span>conflicted</span></p>

    <div class="hero__copy">
      <h1>Signal analysis that never leaves your browser.</h1>
      <p class="hero__lede">
        Demodulation, FEC decoding and an ML modulation classifier, compiled to WebAssembly and run
        entirely client-side. No upload, no server, no account.
      </p>
      <a class="button" href="/web/index.html">Launch app</a>

      <aside class="notice" id="notice" aria-label="What's new">
        <div class="notice__head">
          <p class="notice__label">New: parameter search</p>
          <button class="notice__close" type="button" aria-label="Dismiss">&times;</button>
        </div>
        <h2>Find the code, not just the signal.</h2>
        <p>
          When auto-detect misses, parameter search ranks every interleaver and FEC combination by
          whether the decode checks out, so the message still comes out readable.
        </p>
        <a class="notice__link" href="/web/index.html">Try it in the app</a>
      </aside>
    </div>
  </section>

  <section class="section" id="what">
    <div class="inner split">
      <h2 data-reveal>One tool, from raw capture to readable message</h2>
      <div class="prose" data-reveal style="transition-delay: 90ms">
        <p>
          Deconflicted takes a captured radio signal and works out what is in it: the modulation scheme,
          whether it is interleaved, whether it carries forward error correction, and what the
          decoded message says.
        </p>
        <p>
          It is the same C++ DSP and FEC core as the native desktop tool, compiled to WebAssembly
          and wrapped in a Qt GUI. Because it runs client-side, a capture never has to leave your
          machine.
        </p>
      </div>
    </div>
  </section>

  <section class="section on-black" id="pipeline">
    <div class="inner split">
      <h2 data-reveal>How a capture moves through the pipeline</h2>
      <ol class="stages">
        {
          stages.map((stage, i) => (
            <li class="stages__step" data-reveal style={`transition-delay: ${i * 55}ms`}>
              <span class="stages__n" aria-hidden="true">{String(i + 1).padStart(2, "0")}</span>
              <span class="stages__title">{stage.title}</span>
              <span class="stages__detail">{stage.detail}</span>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="section" id="features">
    <div class="inner">
      <h2 class="section__title" data-reveal>When the signal is not textbook</h2>
      <ul class="features">
        {
          features.map((f, i) => (
            <li class="features__item" data-reveal style={`transition-delay: ${i * 70}ms`}>
              <h3>{f.title}</h3>
              <p>{f.text}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="cta">
    <div class="inner cta__inner" data-reveal>
      <h2>Open a capture and see what is in it.</h2>
      <a class="button" href="/web/index.html">Launch app</a>
    </div>
  </section>
</LandingLayout>

<style is:global>
  .hero {
    position: relative;
    overflow: hidden;
    min-height: max(44rem, 48vw);
    padding: 9rem var(--gutter) 4rem calc(52vw);
  }

  .disc {
    position: absolute;
    left: -14vw;
    top: -16vw;
    width: 60vw;
    height: 60vw;
    border-radius: 50%;
    background: var(--black);
    overflow: hidden;
    transform-origin: 32% 32%;
    will-change: transform;
  }

  .disc canvas {
    display: block;
    width: 100%;
    height: 100%;
    opacity: 0.9;
  }

  /* Darkens the lower-left of the disc so the wordmark keeps its contrast over bright bursts. */
  .disc::after {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(200deg, transparent 35%, rgba(0, 0, 0, 0.88) 78%);
  }

  .wordmark {
    position: absolute;
    left: clamp(1.5rem, 4vw, 4rem);
    top: 31vw;
    display: flex;
    align-items: baseline;
    color: var(--white);
    font-size: clamp(1.9rem, 3.4vw, 4.25rem);
    font-stretch: 125%;
    line-height: 1;
    letter-spacing: -0.01em;
    will-change: transform, opacity;
  }

  .wordmark b {
    font-weight: 800;
  }

  .wordmark span {
    font-weight: 200;
  }

  .hero__waves {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
  }

  .hero__copy {
    position: relative;
    z-index: 2;
    max-width: 34rem;
  }

  .hero h1 {
    font-size: clamp(1.5rem, 2.6vw, 2.5rem);
    letter-spacing: 0.02em;
  }

  .hero__lede {
    margin: 1.5rem 0 2rem;
    max-width: 30rem;
    color: var(--grey-500);
  }

  .notice {
    margin-top: 3.5rem;
    padding: 1.75rem 2rem 1.75rem;
    border-radius: 16px;
    background: var(--grey-100);
  }

  .notice[hidden] {
    display: none;
  }

  .notice__head {
    display: flex;
    justify-content: space-between;
    align-items: start;
    gap: 1rem;
    margin-bottom: 0.75rem;
  }

  .notice__label {
    color: var(--grey-500);
    font-size: 0.875rem;
  }

  .notice__close {
    margin: -0.4rem -0.6rem 0 0;
    padding: 0.2rem 0.6rem;
    border: 0;
    background: none;
    color: var(--black);
    font: inherit;
    font-size: 1.5rem;
    line-height: 1;
    cursor: pointer;
  }

  .notice h2 {
    font-size: clamp(1.05rem, 1.6vw, 1.35rem);
    margin-bottom: 0.75rem;
  }

  .notice p:not(.notice__label) {
    color: var(--grey-700);
    font-size: 0.9375rem;
  }

  .notice__link {
    display: inline-block;
    margin-top: 1rem;
    color: var(--black);
    font-weight: 700;
    text-underline-offset: 0.25em;
  }

  .section {
    padding: clamp(4rem, 9vw, 8rem) 0;
    background: var(--white);
  }

  .section--tight {
    padding-top: 0;
  }

  .section.on-black {
    background: var(--black);
    color: var(--white);
  }

  .on-black h2,
  .on-black h3 {
    color: var(--white);
  }

  .split {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: clamp(2rem, 6vw, 6rem);
    align-items: start;
  }

  .split h2,
  .section__title {
    font-size: clamp(1.4rem, 2.6vw, 2.25rem);
  }

  .prose {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    max-width: 38rem;
  }

  .stages {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid #4a4a4a;
  }

  .stages__step {
    display: grid;
    grid-template-columns: 2.5rem minmax(0, 1fr);
    column-gap: 1rem;
    padding: 1.1rem 0;
    border-bottom: 1px solid #4a4a4a;
  }

  .stages__n {
    grid-row: span 2;
    color: var(--on-black-muted);
    font-variant-numeric: tabular-nums;
  }

  .stages__title {
    font-weight: 700;
    font-stretch: 112%;
  }

  .stages__detail {
    color: var(--on-black-muted);
    font-size: 0.9375rem;
  }

  .features {
    list-style: none;
    margin: 3rem 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 3rem clamp(2rem, 6vw, 6rem);
  }

  .features__item {
    padding-top: 1.25rem;
    border-top: 3px solid var(--black);
  }

  .features__item h3 {
    margin-bottom: 0.75rem;
    font-size: 1.125rem;
  }

  .features__item p {
    max-width: 30rem;
  }

  .cta {
    background: var(--grey-100);
    padding: clamp(3.5rem, 8vw, 6rem) 0;
  }

  .cta__inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
  }

  .cta h2 {
    font-size: clamp(1.4rem, 2.6vw, 2.25rem);
    max-width: 30rem;
  }

  /* Scroll reveal: each element is faded and shifted down while outside the viewport's
     reveal band, and settles into place while inside it -- .is-visible is added AND
     removed by the IntersectionObserver below as that band is crossed in either
     direction, so scrolling back up plays the same motion in reverse, symmetrically,
     rather than leaving everything permanently revealed after a first pass. List items
     carry their own transition-delay (set inline, per item) so a row cascades rather
     than appearing all at once, in both directions. */
  [data-reveal] {
    opacity: 0;
    transform: translateY(22px);
    transition: opacity 0.5s cubic-bezier(0.2, 0.7, 0.2, 1), transform 0.5s cubic-bezier(0.2, 0.7, 0.2, 1);
  }

  [data-reveal].is-visible {
    opacity: 1;
    transform: none;
  }

  @media (prefers-reduced-motion: reduce) {
    [data-reveal] {
      opacity: 1;
      transform: none;
      transition: none;
    }
  }

  @media (max-width: 52rem) {
    .hero {
      min-height: 0;
      padding: 0 var(--gutter) 3rem;
    }
    .disc {
      position: relative;
      left: calc(-1 * var(--gutter));
      top: 0;
      width: calc(100% + 2 * var(--gutter));
      height: 78vw;
      border-radius: 0 0 50% 50% / 0 0 36% 36%;
      margin-bottom: 2rem;
    }
    .wordmark {
      left: var(--gutter);
      top: 54vw;
      font-size: 7.5vw;
    }
    .hero__copy {
      max-width: none;
    }
    .split,
    .features {
      grid-template-columns: 1fr;
    }
    .features {
      gap: 2rem;
    }
  }
</style>

<script>
  // The hero globe: a wireframe sphere of intercepted signals, slowly turning. Meridian
  // and parallel lines give it its shape; a handful of points are "intercepts" (fixed
  // positions on the sphere, each pulsing gently); a few of them are joined by
  // great-circle arcs -- correlated signals, tied together the way parameter search
  // ties a decode to the right FEC/interleaver, or the way the project's own name
  // (Deconflicted) is about sorting out which signal is which. Plain 2D canvas with
  // hand-rolled 3D projection (rotate, then drop z for an orthographic view) rather
  // than WebGL/three.js: this is a few hundred line segments, not a lit, textured
  // scene, and CLAUDE.md's "vanilla JS" rule for /site rules out adding a 3D library
  // for it. Static, at a fixed angle, when the visitor prefers reduced motion.
  type Vec3 = [number, number, number];

  const globeCanvas = document.getElementById("globe") as HTMLCanvasElement | null;
  const gctx = globeCanvas?.getContext("2d");
  if (globeCanvas && gctx) {
    const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    let gw = 0;
    let gh = 0;
    const size = () => {
      const dpr = Math.min(window.devicePixelRatio || 1, 2);
      gw = globeCanvas.clientWidth;
      gh = globeCanvas.clientHeight;
      globeCanvas.width = Math.round(gw * dpr);
      globeCanvas.height = Math.round(gh * dpr);
      gctx.setTransform(dpr, 0, 0, dpr, 0, 0);
    };

    const normalize = (v: Vec3): Vec3 => {
      const len = Math.hypot(v[0], v[1], v[2]) || 1;
      return [v[0] / len, v[1] / len, v[2] / len];
    };
    const fromLatLon = (latDeg: number, lonDeg: number): Vec3 => {
      const lat = (latDeg * Math.PI) / 180;
      const lon = (lonDeg * Math.PI) / 180;
      return [Math.cos(lat) * Math.sin(lon), Math.sin(lat), Math.cos(lat) * Math.cos(lon)];
    };
    const rotateX = ([x, y, z]: Vec3, a: number): Vec3 => {
      const c = Math.cos(a), s = Math.sin(a);
      return [x, y * c - z * s, y * s + z * c];
    };
    const rotateY = ([x, y, z]: Vec3, a: number): Vec3 => {
      const c = Math.cos(a), s = Math.sin(a);
      return [x * c + z * s, y, -x * s + z * c];
    };
    const slerp = (a: Vec3, b: Vec3, t: number): Vec3 => {
      const dot = Math.max(-1, Math.min(1, a[0] * b[0] + a[1] * b[1] + a[2] * b[2]));
      const theta = Math.acos(dot) * t;
      const rel = normalize([b[0] - a[0] * dot, b[1] - a[1] * dot, b[2] - a[2] * dot]);
      const cs = Math.cos(theta), sn = Math.sin(theta);
      return [a[0] * cs + rel[0] * sn, a[1] * cs + rel[1] * sn, a[2] * cs + rel[2] * sn];
    };

    // Meridians (fixed longitude, sweeping latitude) and parallels (fixed latitude,
    // sweeping longitude), sampled as polylines in the sphere's own, unrotated space.
    const meridians: Vec3[][] = [];
    for (let lon = 0; lon < 360; lon += 30) {
      const line: Vec3[] = [];
      for (let lat = -90; lat <= 90; lat += 6) line.push(fromLatLon(lat, lon));
      meridians.push(line);
    }
    const parallels: Vec3[][] = [];
    for (let lat = -60; lat <= 60; lat += 30) {
      const line: Vec3[] = [];
      for (let lon = 0; lon <= 360; lon += 8) line.push(fromLatLon(lat, lon));
      parallels.push(line);
    }

    // Intercepts: fixed points on the sphere (chosen once, not reshuffled per frame),
    // each with its own pulse phase. A few pairs are joined by a correlating arc.
    const intercepts: { p: Vec3; phase: number }[] = Array.from({ length: 20 }, () => ({
      p: fromLatLon(Math.asin(Math.random() * 2 - 1) * (180 / Math.PI), Math.random() * 360),
      phase: Math.random() * Math.PI * 2,
    }));
    const arcs: [number, number][] = [
      [0, 5], [1, 9], [2, 11], [3, 7], [6, 12], [4, 13], [8, 15], [10, 17], [14, 19], [16, 2],
    ];

    const tilt = 0.42; // a fixed 3/4-view tilt, so the sphere never reads as a flat disc face-on
    const project = (v: Vec3, yaw: number, R: number, cx: number, cy: number) => {
      const r = rotateX(rotateY(v, yaw), tilt);
      return { x: cx + r[0] * R, y: cy - r[1] * R, z: r[2] };
    };

    const draw = (yaw: number) => {
      gctx.clearRect(0, 0, gw, gh);
      const cx = gw / 2, cy = gh / 2;
      const R = Math.min(gw, gh) * 0.42;

      const strokeLine = (line: Vec3[], baseAlpha: number) => {
        let open = false;
        for (const v of line) {
          const { x, y, z } = project(v, yaw, R, cx, cy);
          if (z < 0) {
            if (open) gctx.stroke();
            open = false;
            continue;
          }
          const alpha = baseAlpha * (0.35 + 0.65 * z);
          if (!open) {
            gctx.beginPath();
            gctx.strokeStyle = `rgba(255,255,255,${alpha})`;
            gctx.moveTo(x, y);
            open = true;
          } else {
            gctx.strokeStyle = `rgba(255,255,255,${alpha})`;
            gctx.lineTo(x, y);
            gctx.stroke();
            gctx.beginPath();
            gctx.moveTo(x, y);
          }
        }
        if (open) gctx.stroke();
      };

      gctx.lineWidth = 1;
      for (const line of meridians) strokeLine(line, 0.16);
      for (const line of parallels) strokeLine(line, 0.16);

      // The rim: a plain circle at the sphere's silhouette, so it still reads as a
      // solid globe even where the wireframe alone would look sparse.
      gctx.beginPath();
      gctx.strokeStyle = "rgba(255,255,255,0.3)";
      gctx.arc(cx, cy, R, 0, Math.PI * 2);
      gctx.stroke();

      gctx.lineWidth = 1.8;
      for (const [ai, bi] of arcs) {
        const a = intercepts[ai].p, b = intercepts[bi].p;
        const arcLine: Vec3[] = [];
        for (let i = 0; i <= 24; i++) arcLine.push(slerp(a, b, i / 24));
        strokeLine(arcLine, 0.8);
      }

      const now = performance.now() / 1000;
      for (const { p, phase } of intercepts) {
        const { x, y, z } = project(p, yaw, R, cx, cy);
        if (z < -0.05) continue;
        const pulse = 0.5 + 0.5 * Math.sin(now * 1.6 + phase);
        const depth = 0.65 + 0.35 * Math.max(0, z);
        // A soft halo under each point, then the point itself: reads as a small glow
        // rather than a hard-edged pixel, closer to a radar-scope "contact" mark.
        gctx.beginPath();
        gctx.fillStyle = `rgba(255,255,255,${0.16 * depth})`;
        gctx.arc(x, y, (6 + 3 * pulse) * depth, 0, Math.PI * 2);
        gctx.fill();
        gctx.beginPath();
        gctx.fillStyle = `rgba(255,255,255,${(0.75 + 0.25 * pulse) * depth})`;
        gctx.arc(x, y, (2.4 + 1.4 * pulse) * depth, 0, Math.PI * 2);
        gctx.fill();
      }
    };

    size();
    draw(0);
    if (!reduce) {
      new ResizeObserver(() => size()).observe(globeCanvas);
      const ROTATE_SPEED = 0.09; // radians/second -- one slow turn roughly every 70s
      const tick = (ms: number) => {
        if (!document.hidden) draw((ms / 1000) * ROTATE_SPEED);
        requestAnimationFrame(tick);
      };
      requestAnimationFrame(tick);
    } else {
      new ResizeObserver(() => {
        size();
        draw(0.6); // an arbitrary fixed angle, just not the plain front-on default
      }).observe(globeCanvas);
    }
  }

  // Faint drifting signal traces behind the hero copy: plain sines, an amplitude-modulated
  // carrier and a frequency-keyed trace. Static frame when reduced motion is requested.
  const wavesEl = document.getElementById("waves") as HTMLCanvasElement | null;
  const wctx = wavesEl?.getContext("2d");
  if (wavesEl && wctx) {
    const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    let w = 0;
    let h = 0;
    const size = () => {
      const dpr = Math.min(window.devicePixelRatio || 1, 2);
      w = wavesEl.clientWidth;
      h = wavesEl.clientHeight;
      wavesEl.width = Math.round(w * dpr);
      wavesEl.height = Math.round(h * dpr);
      wctx.setTransform(dpr, 0, 0, dpr, 0, 0);
    };

    const lines = [
      { y: 0.14, amp: 16, k: 0.011, speed: 0.5, alpha: 0.16, kind: "sine" },
      { y: 0.3, amp: 22, k: 0.007, speed: -0.35, alpha: 0.13, kind: "am" },
      { y: 0.48, amp: 14, k: 0.016, speed: 0.7, alpha: 0.15, kind: "fsk" },
      { y: 0.66, amp: 26, k: 0.005, speed: -0.25, alpha: 0.12, kind: "sine" },
      { y: 0.82, amp: 18, k: 0.013, speed: 0.45, alpha: 0.14, kind: "am" },
    ];

    const draw = (time: number) => {
      wctx.clearRect(0, 0, w, h);
      wctx.lineWidth = 1.25;
      for (const l of lines) {
        wctx.strokeStyle = `rgba(0,0,0,${l.alpha})`;
        wctx.beginPath();
        for (let x = 0; x <= w; x += 3) {
          const p = x * l.k + time * l.speed;
          let a = l.amp;
          let phase = p;
          if (l.kind === "am") a *= 0.55 + 0.45 * Math.sin(x * 0.0035 - time * 0.4);
          if (l.kind === "fsk") phase = p * (Math.sin(x * 0.004 + time * 0.3) > 0 ? 1.7 : 1);
          const y = l.y * h + a * Math.sin(phase);
          if (x === 0) wctx.moveTo(x, y);
          else wctx.lineTo(x, y);
        }
        wctx.stroke();
      }
    };

    size();
    draw(0);
    if (!reduce) {
      new ResizeObserver(() => size()).observe(wavesEl);
      const tick = (ms: number) => {
        if (!document.hidden) draw(ms / 1000);
        requestAnimationFrame(tick);
      };
      requestAnimationFrame(tick);
    } else {
      new ResizeObserver(() => {
        size();
        draw(0);
      }).observe(wavesEl);
    }
  }

  document.querySelector(".notice__close")?.addEventListener("click", () => {
    document.getElementById("notice")?.setAttribute("hidden", "");
  });

  // Reveal-on-scroll: each [data-reveal] element gets .is-visible while it is inside a
  // band near the bottom of the viewport, and loses it again once scrolled back out of
  // that same band -- toggled both ways, every time, rather than added once and left.
  // Scrolling back up undoes the reveal exactly as it played, the same way the circle
  // below does. Reduced motion is handled entirely in CSS above (elements start
  // visible, so there is nothing for this observer to do).
  const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
  if (!reduceMotion) {
    const targets = document.querySelectorAll("[data-reveal]");
    if ("IntersectionObserver" in window && targets.length) {
      const io = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) entry.target.classList.toggle("is-visible", entry.isIntersecting);
        },
        { threshold: 0.15, rootMargin: "0px 0px -10% 0px" },
      );
      targets.forEach((el) => io.observe(el));
    } else {
      targets.forEach((el) => el.classList.add("is-visible"));
    }
  }

  // The hero circle as a scroll instrument: it shrinks, drifts up and to the left, and
  // rotates a little, purely as a function of scroll position -- not a one-off trigger --
  // so scrolling back up unwinds it to exactly where it started, frame for frame. Desktop
  // only (matches the layout's own 52rem breakpoint): on the stacked mobile layout the
  // disc is a full-width banner, not a hero graphic worth animating this way.
  const disc = document.querySelector<HTMLElement>(".disc");
  const wordmark = document.querySelector<HTMLElement>(".wordmark");
  const heroSection = document.querySelector<HTMLElement>(".hero");
  const desktop = window.matchMedia("(min-width: 52rem)");

  if (disc && wordmark && heroSection && !reduceMotion) {
    const clamp01 = (v: number) => Math.min(1, Math.max(0, v));
    const easeOutCubic = (t: number) => 1 - (1 - t) ** 3;

    let ticking = false;
    const paint = () => {
      ticking = false;
      if (!desktop.matches) {
        disc.style.transform = "";
        wordmark.style.opacity = "";
        wordmark.style.transform = "";
        return;
      }
      // The transform finishes a little before the hero has fully scrolled away, so it
      // never looks like it is still catching up right as the next section arrives.
      const span = heroSection.offsetHeight * 0.85;
      const t = easeOutCubic(clamp01(window.scrollY / span));
      // No CSS rotate() here (there was one before the globe replaced the flat
      // waterfall): the globe already spins in 3D on its own, and layering a 2D spin
      // of the whole disc on top of that reads as jittery rather than purposeful.
      const scale = 1 - 0.4 * t;
      const dx = -0.16 * heroSection.offsetHeight * t;
      const dy = -0.22 * heroSection.offsetHeight * t;
      disc.style.transform = `translate(${dx}px, ${dy}px) scale(${scale})`;
      wordmark.style.opacity = String(1 - t);
      wordmark.style.transform = `translateY(${-30 * t}px)`;
    };
    const onScrollOrResize = () => {
      if (ticking) return;
      ticking = true;
      requestAnimationFrame(paint);
    };
    window.addEventListener("scroll", onScrollOrResize, { passive: true });
    window.addEventListener("resize", onScrollOrResize);
    paint();
  }
</script>

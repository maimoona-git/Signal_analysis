---
import LandingLayout from "../layouts/LandingLayout.astro";

const stages = [
  { title: "Ingestion", detail: "A .wav or .IQ file is read as bytes. Nothing leaves the browser." },
  { title: "DSP and spectral analysis", detail: "FFT and spectrogram, computed in WebAssembly." },
  { title: "ML classification", detail: "A small ONNX model guesses the modulation scheme, in JavaScript." },
  { title: "Demodulation", detail: "17 linear schemes plus FSK, back in the WASM core." },
  { title: "De-interleaving", detail: "Block, diagonal, convolutional or pseudo-random, undone." },
  { title: "FEC decoding", detail: "Viterbi, LDPC, Reed-Solomon, or both concatenated." },
  { title: "Bitstream correlation", detail: "Repeating headers and frame boundaries, found in the decoded bits." },
  { title: "GUI", detail: "Qt Widgets, compiled to WASM, showing every stage above." },
];

const features = [
  {
    title: "Frame raster",
    text: "Lays the decoded bits out at a row width you choose, so repeating frame structure shows up as vertical stripes.",
  },
  {
    title: "Rank analysis",
    text: "Finds a block code's length and rate from raw bits alone, by looking for rank drops over GF(2).",
  },
  {
    title: "Parameter search",
    text: "Tries every offset, interleaver and FEC combination and ranks them by how well the decode re-encodes to the input.",
  },
  {
    title: "Waterfall and constellation",
    text: "Both plots zoom with the wheel and pan by dragging, so a short burst can be inspected up close.",
  },
];

const stack = ["C++ and liquid-dsp", "Qt for WebAssembly", "ONNX Runtime Web", "Embind", "Emscripten"];
---

<LandingLayout
  title="PS 26147: signal analysis in your browser"
  description="PS 26147 is a signal analysis tool that runs entirely in your browser, with no server."
>
  <section class="hero">
    <div class="disc" aria-hidden="true">
      <canvas id="waterfall" width="300" height="300"></canvas>
    </div>
    <p class="wordmark" aria-hidden="true"><b>PS</b><span>26147</span></p>

    <div class="hero__copy">
      <h1>Signal analysis that never leaves your browser.</h1>
      <p class="hero__lede">
        Demodulation, FEC decoding and an ML modulation classifier, compiled to WebAssembly and run
        entirely client-side. No upload, no server, no account.
      </p>
      <a class="button" href="/web/index.html">Launch app</a>

      <aside class="notice" id="notice" aria-label="What's new">
        <div class="notice__head">
          <p class="notice__label">New: parameter search</p>
          <button class="notice__close" type="button" aria-label="Dismiss">&times;</button>
        </div>
        <h2>Find the code, not just the signal.</h2>
        <p>
          When auto-detect misses, parameter search ranks every interleaver and FEC combination by
          whether the decode checks out, so the message still comes out readable.
        </p>
        <a class="notice__link" href="/web/index.html">Try it in the app</a>
      </aside>
    </div>
  </section>

  <section class="section" id="what">
    <div class="inner split">
      <h2>One tool, from raw capture to readable message</h2>
      <div class="prose">
        <p>
          PS 26147 takes a captured radio signal and works out what is in it: the modulation scheme,
          whether it is interleaved, whether it carries forward error correction, and what the
          decoded message says.
        </p>
        <p>
          It is the same C++ DSP and FEC core as the native desktop tool, compiled to WebAssembly
          and wrapped in a Qt GUI. Because it runs client-side, a capture never has to leave your
          machine.
        </p>
      </div>
    </div>
  </section>

  <section class="section on-black" id="pipeline">
    <div class="inner split">
      <h2>How a capture moves through the pipeline</h2>
      <ol class="stages">
        {
          stages.map((stage, i) => (
            <li class="stages__step">
              <span class="stages__n" aria-hidden="true">{String(i + 1).padStart(2, "0")}</span>
              <span class="stages__title">{stage.title}</span>
              <span class="stages__detail">{stage.detail}</span>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="section" id="features">
    <div class="inner">
      <h2 class="section__title">When the signal is not textbook</h2>
      <ul class="features">
        {
          features.map((f) => (
            <li class="features__item">
              <h3>{f.title}</h3>
              <p>{f.text}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="section section--tight" id="stack">
    <div class="inner split">
      <h2>Built with</h2>
      <div class="prose">
        <ul class="stack">
          {stack.map((item) => <li>{item}</li>)}
        </ul>
        <p>There is no Python at runtime. It only exists in the repo as offline training tooling.</p>
      </div>
    </div>
  </section>

  <section class="cta">
    <div class="inner cta__inner">
      <h2>Open a capture and see what is in it.</h2>
      <a class="button" href="/web/index.html">Launch app</a>
    </div>
  </section>
</LandingLayout>

<style is:global>
  .hero {
    position: relative;
    overflow: hidden;
    min-height: max(44rem, 48vw);
    padding: 9rem var(--gutter) 4rem calc(52vw);
  }

  .disc {
    position: absolute;
    left: -14vw;
    top: -16vw;
    width: 60vw;
    height: 60vw;
    border-radius: 50%;
    background: var(--black);
    overflow: hidden;
  }

  .disc canvas {
    display: block;
    width: 100%;
    height: 100%;
    opacity: 0.9;
  }

  /* Darkens the lower-left of the disc so the wordmark keeps its contrast over bright bursts. */
  .disc::after {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(200deg, transparent 35%, rgba(0, 0, 0, 0.88) 78%);
  }

  .wordmark {
    position: absolute;
    left: clamp(1.5rem, 4vw, 4rem);
    top: 31vw;
    display: flex;
    align-items: baseline;
    gap: 0.35em;
    color: var(--white);
    font-size: clamp(2.5rem, 5.6vw, 6rem);
    font-stretch: 125%;
    line-height: 1;
    letter-spacing: -0.02em;
  }

  .wordmark b {
    font-weight: 800;
  }

  .wordmark span {
    font-weight: 200;
  }

  .hero__copy {
    max-width: 34rem;
  }

  .hero h1 {
    font-size: clamp(1.5rem, 2.6vw, 2.5rem);
    letter-spacing: 0.02em;
  }

  .hero__lede {
    margin: 1.5rem 0 2rem;
    max-width: 30rem;
    color: var(--grey-500);
  }

  .notice {
    margin-top: 3.5rem;
    padding: 1.75rem 2rem 1.75rem;
    border-radius: 16px;
    background: var(--grey-100);
  }

  .notice[hidden] {
    display: none;
  }

  .notice__head {
    display: flex;
    justify-content: space-between;
    align-items: start;
    gap: 1rem;
    margin-bottom: 0.75rem;
  }

  .notice__label {
    color: var(--grey-500);
    font-size: 0.875rem;
  }

  .notice__close {
    margin: -0.4rem -0.6rem 0 0;
    padding: 0.2rem 0.6rem;
    border: 0;
    background: none;
    color: var(--black);
    font: inherit;
    font-size: 1.5rem;
    line-height: 1;
    cursor: pointer;
  }

  .notice h2 {
    font-size: clamp(1.05rem, 1.6vw, 1.35rem);
    margin-bottom: 0.75rem;
  }

  .notice p:not(.notice__label) {
    color: var(--grey-700);
    font-size: 0.9375rem;
  }

  .notice__link {
    display: inline-block;
    margin-top: 1rem;
    color: var(--black);
    font-weight: 700;
    text-underline-offset: 0.25em;
  }

  .section {
    padding: clamp(4rem, 9vw, 8rem) 0;
    background: var(--white);
  }

  .section--tight {
    padding-top: 0;
  }

  .section.on-black {
    background: var(--black);
    color: var(--white);
  }

  .on-black h2,
  .on-black h3 {
    color: var(--white);
  }

  .split {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: clamp(2rem, 6vw, 6rem);
    align-items: start;
  }

  .split h2,
  .section__title {
    font-size: clamp(1.4rem, 2.6vw, 2.25rem);
  }

  .prose {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    max-width: 38rem;
  }

  .stages {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid #4a4a4a;
  }

  .stages__step {
    display: grid;
    grid-template-columns: 2.5rem minmax(0, 1fr);
    column-gap: 1rem;
    padding: 1.1rem 0;
    border-bottom: 1px solid #4a4a4a;
  }

  .stages__n {
    grid-row: span 2;
    color: var(--on-black-muted);
    font-variant-numeric: tabular-nums;
  }

  .stages__title {
    font-weight: 700;
    font-stretch: 112%;
  }

  .stages__detail {
    color: var(--on-black-muted);
    font-size: 0.9375rem;
  }

  .features {
    list-style: none;
    margin: 3rem 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 3rem clamp(2rem, 6vw, 6rem);
  }

  .features__item {
    padding-top: 1.25rem;
    border-top: 3px solid var(--black);
  }

  .features__item h3 {
    margin-bottom: 0.75rem;
    font-size: 1.125rem;
  }

  .features__item p {
    max-width: 30rem;
  }

  .stack {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
  }

  .stack li {
    padding: 0.4rem 0.9rem;
    border: 1px solid var(--black);
    border-radius: 999px;
    color: var(--black);
    font-size: 0.9375rem;
  }

  .cta {
    background: var(--grey-100);
    padding: clamp(3.5rem, 8vw, 6rem) 0;
  }

  .cta__inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
  }

  .cta h2 {
    font-size: clamp(1.4rem, 2.6vw, 2.25rem);
    max-width: 30rem;
  }

  @media (max-width: 52rem) {
    .hero {
      min-height: 0;
      padding: 0 var(--gutter) 3rem;
    }
    .disc {
      position: relative;
      left: calc(-1 * var(--gutter));
      top: 0;
      width: calc(100% + 2 * var(--gutter));
      height: 78vw;
      border-radius: 0 0 50% 50% / 0 0 36% 36%;
      margin-bottom: 2rem;
    }
    .wordmark {
      left: var(--gutter);
      top: 54vw;
      font-size: 11vw;
    }
    .hero__copy {
      max-width: none;
    }
    .split,
    .features {
      grid-template-columns: 1fr;
    }
    .features {
      gap: 2rem;
    }
  }
</style>

<script>
  // A scrolling greyscale waterfall: noise floor, steady carriers, a keyed FSK pair and an
  // on/off wideband burst. Static when the visitor prefers reduced motion.
  const canvas = document.getElementById("waterfall") as HTMLCanvasElement | null;
  const ctx = canvas?.getContext("2d");
  if (canvas && ctx) {
    const W = canvas.width;
    const H = canvas.height;
    const img = ctx.createImageData(W, H);
    const px = img.data;
    const carriers = [
      { x: 52, amp: 0.55 },
      { x: 118, amp: 0.4 },
      { x: 231, amp: 0.5 },
      { x: 268, amp: 0.3 },
    ];
    let t = 0;
    let bit = 0;

    const bump = (x: number, centre: number, half: number) => {
      const d = Math.abs(x - centre) / half;
      return d >= 1 ? 0 : 0.5 * (1 + Math.cos(Math.PI * d));
    };

    const newRow = (row: Uint8ClampedArray) => {
      if (t % 7 === 0) bit = Math.random() < 0.5 ? 0 : 1;
      const wideOn = t % 180 < 70;
      for (let x = 0; x < W; x++) {
        let v = 0.06 + 0.16 * Math.random() * Math.random() * 2;
        for (const c of carriers) v += c.amp * bump(x, c.x, 1.6) * (0.75 + 0.25 * Math.random());
        v += 0.62 * bump(x, bit ? 172 : 160, 3.2);
        if (wideOn) v += 0.3 * bump(x, 205, 26) * (0.7 + 0.3 * Math.random());
        const g = Math.min(1, v) ** 1.35 * 205;
        const i = x * 4;
        row[i] = row[i + 1] = row[i + 2] = g;
        row[i + 3] = 255;
      }
      t++;
    };

    const rowBuf = new Uint8ClampedArray(W * 4);
    const push = () => {
      px.copyWithin(W * 4, 0, W * 4 * (H - 1));
      newRow(rowBuf);
      px.set(rowBuf, 0);
    };
    for (let i = 0; i < H; i++) push();
    ctx.putImageData(img, 0, 0);

    if (!window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
      setInterval(() => {
        if (document.hidden) return;
        push();
        ctx.putImageData(img, 0, 0);
      }, 70);
    }
  }

  document.querySelector(".notice__close")?.addEventListener("click", () => {
    document.getElementById("notice")?.setAttribute("hidden", "");
  });
</script>
